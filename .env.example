DATABASE_URL=postgres://user:password@localhost:5432/pick_me_a_dinner
APP_PASSWORD=changeme
APP_SECRET=replace-with-a-long-random-string
APP_TZ=America/Los_Angeles
GOOGLE_PLACES_API_KEY=

# AI search (optional — Tonight's search box is hidden when ANTHROPIC_API_KEY
# is unset, and `pnpm build` succeeds without any of these set).
#
# ANTHROPIC_API_KEY — your Anthropic API key. Presence enables the AI search
#   box on Tonight.
# AI_MODEL — which Claude model to call. Defaults to claude-opus-4-7.
#   Also supported: claude-sonnet-4-6, claude-haiku-4-5 (both use the
#   budget-thinking API; Opus uses adaptive-thinking and is streamed).
# AI_EFFORT — thinking effort. One of off/low/medium/high (default `low`),
#   or — for the budget-API models only — a bare integer used directly as
#   `budget_tokens`. A positive integer paired with an Opus model throws
#   at client construction (it's nonsensical for the adaptive API).
# AI_TAIL_MODE — open-query rationale shape. One of full/pithy/drop.
#   Default `pithy`: weak picks get a few-word note, obviously bad picks
#   get an empty-string rationale (no rationale line on the row).
ANTHROPIC_API_KEY=
AI_MODEL=
AI_EFFORT=
AI_TAIL_MODE=
