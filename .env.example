DATABASE_URL=postgres://user:password@localhost:5432/pick_me_a_dinner
APP_PASSWORD=change-me
APP_SECRET=change-me-to-a-long-random-string
APP_TZ=America/New_York
GOOGLE_PLACES_API_KEY=

# --- AI search (all optional) ---
# When ANTHROPIC_API_KEY is absent the AI-search box is hidden entirely on
# Tonight (the screen reads as v1). Setting any of the AI_* vars below has no
# effect without a key.
ANTHROPIC_API_KEY=

# Model selection — defaults to claude-opus-4-7 (adaptive thinking). The
# shipped feature also supports claude-sonnet-4-6 and claude-haiku-4-5
# (budget thinking).
AI_MODEL=

# Thinking effort. Either a canonical level — off / low / medium / high — or,
# for the budget-API models (Sonnet, Haiku), a bare integer used directly as
# budget_tokens (floor 1024; 0 means off). A positive numeric value is
# rejected at construction when paired with an Opus model.
AI_EFFORT=

# Open-query tail mode — full / pithy / drop. Defaults to pithy.
AI_TAIL_MODE=
